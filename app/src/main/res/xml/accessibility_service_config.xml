<?xml version="1.0" encoding="utf-8"?>
<!--
  Service des touches de couleur : il filtre les touches (seules les quatre touches de couleur
  sont gardées, voir ColorKeyFilter), ne lit aucun contenu d'écran, et ne reçoit que les
  annonces de l'application elle-même (aucun événement des autres applications).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/color_keys_service_description"
    android:summary="@string/color_keys_service_summary"
    android:accessibilityEventTypes="typeAnnouncement"
    android:packageNames="be.jeedomtv"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
